diagram "Six copies of one join"
theme drafting

node sql "generated query" shape=code lang=sql <<SQL
  SELECT DISTINCT S1.NAME AS CUSTOMER_NAME, S1.SCORE, S7.AGG AS ORDER_COUNT, S9.AGG AS ITEM_COUNT, S1.MARKET, S1.REGION, S1.SEGMENT
  FROM CUSTOMERS AS S1
    JOIN (SELECT ORDER_ID, CUSTOMER_ID FROM ONLINE_ORDERS AS S2   -- copy 1
          UNION SELECT ORDER_ID, CUSTOMER_ID FROM STORE_ORDERS AS S3) AS S4
      ON S4.CUSTOMER_ID = S1.ID
    JOIN ORDER_ITEMS AS S5 ON S5.ORDER_ID = S4.ORDER_ID
    JOIN (SELECT G0, G1, G2, G3, G4, G5, G6, COUNT(*) AS AGG FROM (               -- copy 2
            SELECT DISTINCT S1.ID AS G0, S1.NAME AS G1, S1.SCORE AS G2, S1.MARKET AS G3, S1.REGION AS G4, S1.SEGMENT AS G5, S1.TIER AS G6, S5.ID AS P0
            FROM CUSTOMERS AS S1 JOIN (SELECT ORDER_ID, CUSTOMER_ID FROM ONLINE_ORDERS) AS S4 JOIN ORDER_ITEMS AS S5)
          GROUP BY G0, G1, G2, G3, G4, G5, G6) AS S7
      ON S7.G0 = S1.ID AND S7.G6 = S1.MARKET
  ORDER BY CUSTOMER_NAME, S1.SCORE DESC
  LIMIT 50
SQL
