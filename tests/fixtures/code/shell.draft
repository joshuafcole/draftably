diagram "A shell pipeline"
theme drafting

node sh shape=code lang=sh wrap=on <<SH
  #!/usr/bin/env bash
  set -euo pipefail
  cat <<EOF > /tmp/query.sql
  SELECT 1;
  EOF
  psql "$DATABASE_URL" -At -c "select id, payload from events where created_at > now() - interval '1 day' and kind in ('order', 'refund', 'chargeback') order by created_at" \
    | jq -r 'select(.payload.total > 100) | "\(.id)\t\(.payload.total)"' \
    | sort -k2 -n -r | head -n 20 > "$(date +%F)-top.tsv"
SH
